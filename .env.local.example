# Google AI (portrait + bio/taunt generation)
GOOGLE_AI_API_KEY=your_key_here

# ElevenLabs (battle narration voice)
ELEVENLABS_API_KEY=your_key_here

# Solana devnet RPC (public devnet RPC URL; used client-side for the wallet
# connection and server-side for building/uploading mint transactions)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana devnet keypair secret (server-only, used ONLY to pay for Arweave metadata uploads at mint time — never used to hold or transfer NFTs, never sent to the client)
SOLANA_MINT_AUTHORITY_SECRET=your_keypair_secret_here
